{
  "name": "nexusnote-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Anthropic MCP server configuration for NexusNote debate features.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "start:websocket": "node dist/index.js",
    "build": "tsc -p .",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.6",
    "pino": "^9.4.0",
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "jose": "^5.9.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
